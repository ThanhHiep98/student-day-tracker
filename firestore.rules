rules_version = '2';

// Student Day Tracker — Firestore Security Rules (F2,
// plans/2026-10-01-v2-roadmap-cross-midnight.html §2.4).
// Spec: tests/rules/firestore.rules.test.ts (pnpm test:emulator).
// Field limits mirror the pure builders (build-activity.ts, build-category.ts,
// build-user-profile.ts). Deployed by the owner (U10), not by CI.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function intIn(v, lo, hi) {
      return v is int && v >= lo && v <= hi;
    }

    // F3 (ADR-009 §2.2 D10/D12) — the AI consent sheet's choice, reversible
    // from the account menu. `at` mirrors `Date.now()` (ms).
    function validAiConsent(d) {
      return d.keys().hasOnly(['granted', 'at'])
        && d.granted is bool
        && d.at is number;
    }

    function validProfile(d) {
      return d.keys().hasAll(['displayName', 'email', 'photoURL', 'createdAt', 'privacyAcceptedAt'])
        && d.keys().hasOnly(['displayName', 'email', 'photoURL', 'createdAt', 'privacyAcceptedAt',
                             'migratedFromDexieAt', 'aiConsent'])
        && str(d.displayName, 0, 200)
        && str(d.email, 0, 320)
        && (d.photoURL == null || str(d.photoURL, 1, 2048))
        && d.createdAt is number
        && d.privacyAcceptedAt is number
        && (!('migratedFromDexieAt' in d) || d.migratedFromDexieAt is number)
        && (!('aiConsent' in d) || validAiConsent(d.aiConsent));
    }

    // Times: start 0-1439, end 1-1440 (end-exclusive; 1440 = ends at midnight).
    // A cross-midnight activity is two docs sharing spanId.
    function validActivity(id, d) {
      return d.keys().hasAll(['id', 'categoryId', 'name', 'date', 'startMinutes', 'endMinutes',
                              'createdAt'])
        && d.keys().hasOnly(['id', 'categoryId', 'name', 'date', 'startMinutes', 'endMinutes',
                             'spanId', 'createdAt'])
        && d.id == id
        && str(d.categoryId, 1, 100)
        && str(d.name, 1, 200)
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && intIn(d.startMinutes, 0, 1439)
        && intIn(d.endMinutes, 1, 1440)
        && d.startMinutes < d.endMinutes
        && d.createdAt is number
        && (!('spanId' in d) || str(d.spanId, 1, 100));
    }

    // Only custom categories are stored; the defaults live in code.
    function validCategory(id, d) {
      return d.keys().hasAll(['id', 'name', 'color', 'icon', 'isDefault', 'createdAt'])
        && d.keys().hasOnly(['id', 'name', 'color', 'icon', 'isDefault', 'createdAt'])
        && d.id == id
        && str(d.name, 1, 50)
        && d.color is string && d.color.matches('^#[0-9a-fA-F]{6}$')
        && str(d.icon, 1, 16)
        && d.isDefault == false
        && d.createdAt is number;
    }

    // ADR-008 §2.3/§2.6 — users/{uid}/goals/habits. Field limits mirror the D6
    // ranges enforced by build-habit-goals.ts.
    function validTimeBlock(b) {
      return b.keys().hasOnly(['startMinutes', 'endMinutes'])
        && intIn(b.startMinutes, 300, 1320)
        && intIn(b.endMinutes, 300, 1320)
        && b.startMinutes < b.endMinutes;
    }

    function validBlocks(blocks) {
      return blocks is list && blocks.size() <= 2
        && (blocks.size() < 1 || validTimeBlock(blocks[0]))
        && (blocks.size() < 2 || validTimeBlock(blocks[1]));
    }

    function blockMinutes(b) {
      return b.endMinutes - b.startMinutes;
    }

    function schoolMinutes(blocks) {
      return blocks.size() == 0 ? 0
        : (blocks.size() == 1 ? blockMinutes(blocks[0])
                               : blockMinutes(blocks[0]) + blockMinutes(blocks[1]));
    }

    function validSleep(d) {
      return d.keys().hasOnly(['targetMinutes', 'bedtimeMinutes', 'categoryId'])
        && intIn(d.targetMinutes, 240, 720)
        && intIn(d.bedtimeMinutes, 0, 1439)
        && str(d.categoryId, 1, 100);
    }

    function validSchool(d) {
      return d.keys().hasOnly(['days', 'blocks', 'categoryId'])
        && d.days is list && d.days.size() <= 7 && d.days.hasOnly([1, 2, 3, 4, 5, 6, 7])
        && validBlocks(d.blocks)
        && str(d.categoryId, 1, 100);
    }

    function validExtraClass(d) {
      return d.keys().hasOnly(['targetMinutesPerDay', 'categoryId'])
        && intIn(d.targetMinutesPerDay, 0, 480)
        && str(d.categoryId, 1, 100);
    }

    function validSelfStudy(d) {
      return d.keys().hasOnly(['targetMinutesPerDay', 'categoryId'])
        && intIn(d.targetMinutesPerDay, 0, 600)
        && str(d.categoryId, 1, 100);
    }

    function validMeals(d) {
      return d.keys().hasOnly(['targetMinutesPerDay', 'categoryId'])
        && intIn(d.targetMinutesPerDay, 15, 240)
        && str(d.categoryId, 1, 100);
    }

    function validEntertainment(d) {
      return d.keys().hasOnly(['maxMinutesPerDay', 'categoryId'])
        && (d.maxMinutesPerDay == null || intIn(d.maxMinutesPerDay, 0, 720))
        && str(d.categoryId, 1, 100);
    }

    function validHabitGoals(d) {
      return d.keys().hasAll(['version', 'status', 'lastStep', 'sleep', 'school', 'extraClass',
                              'selfStudy', 'meals', 'entertainment', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['version', 'status', 'lastStep', 'sleep', 'school', 'extraClass',
                             'selfStudy', 'meals', 'entertainment', 'createdAt', 'updatedAt',
                             'completedAt'])
        && d.version == 1
        && d.status in ['in-progress', 'skipped', 'completed']
        && intIn(d.lastStep, 0, 5)
        && validSleep(d.sleep)
        && validSchool(d.school)
        && validExtraClass(d.extraClass)
        && validSelfStudy(d.selfStudy)
        && validMeals(d.meals)
        && validEntertainment(d.entertainment)
        && d.createdAt is number
        && d.updatedAt is number
        && (!('completedAt' in d) || d.completedAt is number)
        // D6: planned total excl. entertainment <= 24h.
        && (d.sleep.targetMinutes + schoolMinutes(d.school.blocks) + d.extraClass.targetMinutesPerDay
            + d.selfStudy.targetMinutesPerDay + d.meals.targetMinutesPerDay) <= 1440;
    }

    // ADR-009 §2.3 — users/{uid}/dayRatings/{date}. Doc id is the IsoDate
    // (not stored as a field); field limits mirror build-day-rating.ts.
    function validDayRating(id, d) {
      return d.keys().hasAll(['score', 'updatedAt'])
        && d.keys().hasOnly(['score', 'updatedAt', 'note'])
        && id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && intIn(d.score, 1, 5)
        && d.updatedAt is number
        && (!('note' in d) || str(d.note, 0, 280));
    }

    // ADR-009 §2.3 F3 — users/{uid}/aiComments/{date}. Doc id is the IsoDate;
    // field limits mirror build-ai-comment.ts (AI_COMMENT_TEXT_MAX = 2000).
    function validAiComment(id, d) {
      return d.keys().hasAll(['text', 'model', 'inputHash', 'createdAt'])
        && d.keys().hasOnly(['text', 'model', 'inputHash', 'createdAt'])
        && id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && str(d.text, 1, 2000)
        && str(d.model, 1, 100)
        && str(d.inputHash, 1, 32)
        && d.createdAt is number;
    }

    // ADR-009 §2.3/D14/D16 slice 8a — users/{uid}/summaries/{date}, the only
    // document a linked parent will ever be allowed to read (parent read
    // access itself is 8b; today this is owner-only). Numbers only, mirroring
    // build-day-summary.ts: no activity names/times, category names, notes,
    // AI text, display name or email can fit this shape.
    function validSummaryGoal(g) {
      return g.keys().hasOnly(['actual', 'target', 'score'])
        && intIn(g.actual, 0, 1440)
        && (g.target == null || intIn(g.target, 0, 1440))
        && (g.score == null || (g.score is number && g.score >= 0 && g.score <= 1));
    }

    function validSummaryGoals(goals) {
      return goals.keys().hasAll(['sleep', 'school', 'extraClass', 'selfStudy', 'meals', 'entertainment'])
        && goals.keys().hasOnly(['sleep', 'school', 'extraClass', 'selfStudy', 'meals', 'entertainment'])
        && validSummaryGoal(goals.sleep)
        && validSummaryGoal(goals.school)
        && validSummaryGoal(goals.extraClass)
        && validSummaryGoal(goals.selfStudy)
        && validSummaryGoal(goals.meals)
        && validSummaryGoal(goals.entertainment);
    }

    function validSummaryWarnings(warnings) {
      return warnings is list && warnings.size() <= 10
        && warnings.hasOnly(['sleep-short', 'bedtime-late', 'entertainment-over', 'target-missed']);
    }

    function validDaySummary(id, d) {
      return d.keys().hasAll(['efficiency', 'goals', 'warnings', 'ratingScore', 'updatedAt'])
        && d.keys().hasOnly(['efficiency', 'goals', 'warnings', 'ratingScore', 'updatedAt'])
        && id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (d.efficiency == null || intIn(d.efficiency, 0, 100))
        && validSummaryGoals(d.goals)
        && validSummaryWarnings(d.warnings)
        && (d.ratingScore == null || intIn(d.ratingScore, 1, 5))
        && d.updatedAt is number;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validProfile(request.resource.data);
      allow update: if isOwner(uid) && validProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['migratedFromDexieAt', 'displayName', 'photoURL', 'aiConsent']);
      // No delete: account deletion is a follow-up (plan §2.2 Q2).

      match /activities/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validActivity(id, request.resource.data);
      }

      match /categories/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validCategory(id, request.resource.data);
      }

      match /goals/{goalId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && goalId == 'habits' && validHabitGoals(request.resource.data);
      }

      match /dayRatings/{date} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validDayRating(date, request.resource.data);
      }

      // F3 — owner only (no parent read; the parent view, slice 8, is a later
      // PR and only ever reads `summaries/{date}`, never raw AI text).
      match /aiComments/{date} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validAiComment(date, request.resource.data);
      }

      // ADR-009 slice 8a — owner only for now. Parent read access
      // (`exists(/users/$(uid)/parents/$(request.auth.uid))`) is added in 8b,
      // once the `parents` subcollection and invite flow exist.
      match /summaries/{date} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validDaySummary(date, request.resource.data);
      }
    }
  }
}
